GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_ALLOWED_REPOSITORIES=owner/repository
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/pi_governance
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=replace-me
# 可选：OpenAI 兼容网关等自定义服务。不填 MODEL_BASE_URL 时使用 Pi 内置厂商配置。
# MODEL_BASE_URL=https://gateway.example.com/v1
# MODEL_API=openai-completions   # 或 openai-responses / anthropic-messages
# MODEL_THINKING=high             # off / minimal / low / medium / high / xhigh
PORT=3000
WEBHOOK_MAX_BYTES=1048576
QUEUE_CAPACITY=20
AGENT_TIMEOUT_MS=300000
GITHUB_CLIENT_ID=Iv1.example
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
# 健康检查的依赖漏洞检查：把锁文件里的"包名 + 版本"发给 api.osv.dev 查询。
# 私有仓库的内部包名也会发出去；不希望发出时设为 false。默认开启。
VULNERABILITY_SCAN_ENABLED=true
# 代码规则扫描（健康检查全仓 + PR 改动文件）：用项目自带的 rules/semgrep 本地规则跑 Semgrep，不联网、不运行仓库脚本。
# 需要部署环境安装 Semgrep（pip install semgrep）；没装时报告会注明未扫描。默认开启。
SAST_SCAN_ENABLED=true
# SEMGREP_PATH=semgrep

# 可选：按本机已有代理填写，Node 24 原生支持；不要关闭 TLS 校验。
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
# 已结束任务（含审查结果、Agent 记录）保留天数；活跃 PR 的历史和每个仓库最近一份健康报告不删。0 表示永久保留。
DATA_RETENTION_DAYS=90
# 卸载 App 或移除仓库后，再等多少天删除该仓库的全部数据（含团队规则）；暂停安装不算。0 表示不删除。
REVOKED_DATA_GRACE_DAYS=30
# 每个实例同时执行的任务数；同一仓库的 PR 任务仍然串行。可以起多个实例共用同一个数据库。
WORKER_CONCURRENCY=2

# 可选：PR 审查完成后，向一个企业微信内部群发送通知并 @ PR 作者。
# Webhook 是凭据，不要提交真实值；多实例必须使用相同配置。不填则不发送。
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me
# 每个项目的成员关联在前端「仓库 → 通知成员」设置，保存后生效，无需重启。

# 企业微信智能机器人（API 模式：长连接）。与通知群 Webhook 相互独立。
# 两项必须一起配置；不配置时不开启群内开发 Worker。
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 开发任务（含图片输入）的总 token 上限，未知消耗仍计入预算。
DEVELOPMENT_BUDGET_TOKENS=160000
